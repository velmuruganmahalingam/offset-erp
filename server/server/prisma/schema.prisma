generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  sections  String[]
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
}

model Project {
  id Int @id @default(autoincrement())

  ofNo String @unique

  orderDate DateTime?

  proofDate DateTime?

  deliveryDate DateTime?

  size String?

  gsm String?

  numberOfCopies Int?

  layout String?

  designBy String?

  rawMaterialByParty Boolean @default(false)

  openStyle String?

  numberOfColours Int?

  nofcolors String?

  extraColour String?

  specialEffects String[]

  lamination String?
                                                                
  laminationFinish String?                                                                                                

  creasing Boolean @default(false)

  pasting Boolean @default(false)

  designDetails String?

  numberOfPapers Int?

  numberOfPages Int?

  numberOfPlates Int?

  numberOfDrawings Int?

  numberOfPositive Int?

  numberOfCD Int?

  jobType String

  processType String

  customerName String

  mobile String?

  place String?

  orderTakenBy String?

  coverDetails Json?

  paymentDetails Json?

  workflow Json?

  workflows Workflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaperSize {
  id        Int @id @default(autoincrement())
  name      String @unique
  isActive  Boolean @default(true)

  mappings  PaperOption[]
}

model Gsm {
  id        Int @id @default(autoincrement())
  value     Int @unique
  isActive  Boolean @default(true)

  mappings  PaperOption[]
}

model PaperType {
  id        Int @id @default(autoincrement())
  name      String @unique
  isActive  Boolean @default(true)

  mappings  PaperOption[]
}

model PaperOption {
  id Int @id @default(autoincrement())

  sizeId Int
  gsmId Int
  paperTypeId Int

  size PaperSize @relation(fields: [sizeId], references: [id])
  gsm Gsm @relation(fields: [gsmId], references: [id])
  paperType PaperType @relation(fields: [paperTypeId], references: [id])

  @@unique([sizeId, gsmId, paperTypeId])
}

model Workflow {
  id Int @id @default(autoincrement())

  projectId Int
  project Project @relation(fields:[projectId], references:[id])

  stageId     Int

  stage WorkflowStage @relation(fields: [stageId], references: [id])

  status String

  assignedTo String?

  assignedSystem String?

  assignedDate DateTime?
  deadline DateTime?

  notes String?

  createdAt DateTime @default(now())
}

model WorkflowStage {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  order     Int
  isActive  Boolean @default(true)

  workflows Workflow[]
}